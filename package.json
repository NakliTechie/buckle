{
  "name": "buckle-dev",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Dev harness for Buckle. The product ships as a single HTML file; nothing here ships.",
  "scripts": {
    "transpile": "tsc -p tsconfig.engine.json",
    "bundle": "esbuild engine/entry.ts --bundle --format=esm --outfile=engine.esm.js --log-level=warning",
    "test:engine": "vitest run --dir build/sim",
    "gate:c1": "tools/gate-c1.sh"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
